# Host port the app is published on.
PORT=8000

# Comma-separated origins allowed to call the API cross-origin. Leave empty when
# the frontend is served by the app itself, which is the default.
CORS_ORIGINS=

# Requests allowed per client IP, as "N/second|minute|hour|day" joined with ";".
# RATE_LIMIT_CREATE=10/minute;100/day
# RATE_LIMIT_REDIRECT=60/minute
# RATE_LIMIT_API=300/minute

# Behind a reverse proxy, trust its X-Forwarded-* headers so short URLs carry the
# public host and scheme. Use the proxy's IP, or * if only the proxy can reach the app.
# FORWARDED_ALLOW_IPS=*
